{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/vendor",
    "**/*.wasm",
    "**/*.d.ts.map",
    "**/*.js.map",
    "**/*.md",
    "**/*.html",
    "**/*.yml",
    "**/*.yaml",
    "**/*.json",
    "**/src/utils.ts",
    "**/src/zstd-wasm-decoder.ts",
    "**/src/shared.ts"
  ]
}
